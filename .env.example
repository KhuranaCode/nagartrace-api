# NagarTrace API - environment variables. No real values here. Never commit a real .env.
NODE_ENV=staging                      # 'production' refuses dev-default policy values
PORT=8080
DATABASE_URL=                         # runtime role (nagartrace_runtime), pooled connection
ADMIN_DATABASE_URL=                   # owner connection, used only by `npm run migrate` and bootstrap, never by the API
AUTH_ISSUER=                          # exact `iss` of the JWTs, e.g. https://<project>.supabase.co/auth/v1
AUTH_AUDIENCE=                        # exact `aud`, e.g. authenticated (confirm on the live project)
AUTH_JWKS_URL=                        # e.g. https://<project>.supabase.co/auth/v1/.well-known/jwks.json
CORS_ORIGINS=                         # comma-separated exact frontend origins
TRUST_PROXY=false                     # true only behind a trusted proxy
PUBLIC_SCORECARDS=false               # legal review pending
# Storage: local disk by default; S3-compatible when S3_ENDPOINT is set (adapter is mock-tested only)
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Policy values: all POLICY_* must be set for production (see src/config.ts POLICY_KEYS),
# plus POLICY_SPOOF_RESIDENCY_ACK=confirmations-are-not-resident-verification.
# Hosted TEST on synthetic data only (not production, no real citizen data):
# POLICY_USE_DEV_DEFAULTS=synthetic-test-only

# Required outside dev defaults: officer_review (safe default) or auto_checks (provisional)
POLICY_VERIFICATION_MODE=officer_review

# Optional, default off. any_municipal_staff lets all municipal staff see and claim unrouted reports (provisional, synthetic demo only)
# POLICY_UNROUTED_TRIAGE=off
